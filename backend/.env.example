# =============================================================================
# AuntieJoy backend configuration
#
# Copy this file to `backend/.env` and fill in your own values:
#     cp backend/.env.example backend/.env
#
# config.py calls load_dotenv(), which reads `.env` from the CURRENT WORKING
# DIRECTORY. The README starts the server from inside `backend/`, so the file
# must live at `backend/.env` and uvicorn must be run from `backend/`.
#
# EVERYTHING here is optional. With an empty file the backend runs fully offline
# against its deterministic mock LLM, and the voice pipeline reports itself as
# unconfigured rather than pretending: /health shows asr_configured=false and
# tts_configured=false, and the UI keeps the mic and the mouth disabled. Fill a
# block in only when you want that provider live.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. LLM (the five bounded agents). Any OpenAI-compatible endpoint.
#    Presence of a key is what flips the agents from mock to live.
#    Fail-closed: any error drops that ONE agent to its deterministic mock.
# -----------------------------------------------------------------------------
# Tencent Hunyuan (via TokenHub), SiliconFlow, and OpenAI all work -- anything that
# speaks the OpenAI /chat/completions shape. The KEY NAME is the only oddity: the
# variable is still called HUNYUAN_API_KEY for backwards compatibility, but it holds
# whatever key matches AUNTIEJOY_LLM_BASE below.
HUNYUAN_API_KEY=
# Alternative key name, read if HUNYUAN_API_KEY is empty.
SILICONFLOW_API_KEY=
# Any OpenAI-compatible base URL, ending in /v1 (no trailing slash needed).
#   OpenAI        https://api.openai.com/v1
#   TokenHub      https://tokenhub-intl.tencentcloudmaas.com/v1
#   SiliconFlow   https://api.siliconflow.cn/v1
AUNTIEJOY_LLM_BASE=https://api.openai.com/v1
# Model id served by the endpoint above. It must belong to the base URL: pairing an
# OpenAI key with a Tencent model id fails at request time, not at startup, so /health
# is the place to check -- it reports llm_reachable alongside llm_configured.
#   OpenAI        gpt-4o-mini
#   TokenHub      deepseek/deepseek-flash
#   SiliconFlow   tencent/Hunyuan-A13B-Instruct
AUNTIEJOY_LLM_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# 2. EARS - speech to text. Tencent Cloud realtime ASR over WebSocket.
#    ALL THREE of SECRET_ID / SECRET_KEY / APPID are required to enable it
#    (Settings.LIVE_ASR is true only when all three are non-empty).
#
#    AppID appears in the signed URL path, so it is not optional.
#    Get these from the Tencent Cloud console: Access Management > API Keys,
#    and the AppID from your account info / the ASR console.
#
#    Note: the realtime ASR endpoint (asr.cloud.tencent.com) is a Tencent Cloud
#    INTERNATIONAL-site product. Overseas calls must be made from an account
#    that has ASR activated on the international site, or the handshake returns
#    code 6001.
# -----------------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_APPID=
# ap-singapore | ap-shanghai | ...
# The realtime ASR URL (asr.cloud.tencent.com) is region-agnostic, but this value
# is NOT cosmetic: it is the fallback for TENCENTCLOUD_TTS_REGION below, so
# setting it here also picks the TTS endpoint region.
TENCENTCLOUD_REGION=ap-singapore
# Default ASR language when the client does not send one: en | zh | bm
#   en / zh -> engine 16k_zh_en      (Chinese + English, auto-detects)
#   bm      -> engine 16k_multi_lang (English + Malay + 13 others, no Chinese)
AUNTIEJOY_ASR_LANGUAGE=en
# 1 (default) = keep spoken numbers as words in the transcript ("one fifty", "一百五十"), so the
# chat shows what the customer actually said and "one hundred and fifty" is never mistaken for
# the ambiguous "one fifty". 0 = Tencent's own digit conversion ("150" for both).
# Applies to the English/Chinese engine only; Malay (16k_multi_lang) keeps digits.
AUNTIEJOY_ASR_NUMBERS_AS_WORDS=1


# -----------------------------------------------------------------------------
# 3. MOUTH - WHICH ENGINE SPEAKS. Two providers, switchable at runtime.
#
#    The app has TWO mouths and picks one at startup from AUNTIEJOY_TTS_PROVIDER
#    below. The browser's "TRTC Mode" toggle switches between them LIVE, without a
#    restart, via POST /tts/provider.
#
#    A voice provider is not a security boundary: it changes only which engine
#    turns an already-decided line into sound. It cannot change what Joy says, who
#    authorises a payment, or any stage of the control chain.
#
#      cartesia         Cartesia Sonic. THE DEFAULT. The only one of the two with a
#                       real Malay voice, and the only one with no character cap.
#      texttovoice      Tencent Cloud TTS TextToVoice   (block 3b)
#      texttospeechsse  Tencent TRTC streaming TTS      (block 3c)
#
#    THE FALLBACK IS REPORTED, NOT SILENT. If the selected engine cannot speak
#    (out of credit, bad key, service down) the other one answers instead, /health
#    says so in tts_fallback_reason, and the UI's SPEAKING row turns amber. A voice
#    that changes without explanation is more confusing than one that says why.
#    Set AUNTIEJOY_TTS_FALLBACK=0 to make a failure a hard failure instead.
# -----------------------------------------------------------------------------

# ---- provider 1 of 2: CARTESIA (the default) --------------------------------
#
# Endpoint: POST https://api.cartesia.ai/tts/bytes    (raw PCM out, no container)
# A SEPARATE vendor and a SEPARATE bill from Tencent Cloud. The API key stays
# server-side; the browser only ever receives audio from our own /tts endpoint.
#
# BILLING IS THE THING TO WATCH. Cartesia bills per character, and when the
# account runs out the API returns HTTP 402 quota_exceeded. A single short word
# costs a handful of credits, so an account with a few credits left sounds broken
# rather than empty. Top up at https://play.cartesia.ai/subscription, or leave
# TRTC Mode switched on and speak with Tencent instead.
#
# LANGUAGE COVERAGE: Sonic speaks 44 languages, INCLUDING MALAY (ms). That is why
# it is the default -- Tencent has no Malay voice at all, so only Cartesia reads
# Bahasa Melayu natively instead of borrowing an English voice.
CARTESIA_API_KEY=
# Pinned deliberately: Cartesia versions its API by date, and the request/response
# shape is not guaranteed to be stable across versions.
CARTESIA_API_VERSION=2025-04-16
CARTESIA_MODEL=sonic-3-2026-01-12
CARTESIA_ENDPOINT=api.cartesia.ai
# Voice ids are UUIDs, one per language; the app picks by the UI language.
CARTESIA_VOICE_ID_EN=
CARTESIA_VOICE_ID_ZH=
CARTESIA_VOICE_ID_BM=
# A PLAIN MULTIPLIER, not Tencent's offset scale -- the two are NOT
# interchangeable. Range [0.6, 1.5], where 1.0 is the voice's natural pace.
# Tencent's equivalent is AUNTIEJOY_TTS_SPEED further down, in units of [-2, 6].
CARTESIA_SPEED=1.0


# -----------------------------------------------------------------------------
# 3b. MOUTH, provider 2 of 2: Tencent Cloud Text To Speech, action TextToVoice
#     (international site, API version 2019-08-23), signed with TC3-HMAC-SHA256.
#
#     Reuses the SAME Tencent Cloud credentials as the ears above, so there is
#     nothing extra to obtain. The SecretKey stays server-side; the browser only
#     ever receives audio from our own /tts endpoint.
#
#     Requires: TENCENTCLOUD_SECRET_ID + TENCENTCLOUD_SECRET_KEY + at least one
#     voice id. If TTS is not activated on the account the API returns
#     InvalidParameterValue.AppIdNotRegistered - activate it in the TTS console:
#     https://console.tencentcloud.com/tts
#
#     This is the engine the UI calls "Tencent", and the one a Cartesia fallback
#     lands on when TRTC streaming is not configured.
# -----------------------------------------------------------------------------
# Singapore endpoint, matching the region the demo runs from.
TENCENTCLOUD_TTS_REGION=ap-singapore
TENCENTCLOUD_TTS_ENDPOINT=tts.ap-singapore.tencentcloudapi.com

# Voice ids are Tencent VoiceType integers.
# Full catalogue: https://www.tencentcloud.com/document/product/1154/48916
#
# The defaults below give a warm, soft, FEMALE voice with a southern-Chinese character,
# applied across all three languages. They were chosen by probing the live API, not from the
# catalogue page, because two facts decide them and neither is documented:
#
#   1. A Chinese voice CAN read English; an English voice CANNOT read Chinese (it fails with
#      InvalidParameter.InvalidText). So English is spoken by the Chinese voice model, which
#      is what gives it a genuine Chinese accent -- not a filter over an English voice.
#   2. Dialect voices are not safe everywhere. 101019 (zhitong, Cantonese) is the only
#      premium voice documented as southern and it reads Mandarin correctly, but it is
#      UNINTELLIGIBLE on Malay: transcribing its own output back gives a 15% character match
#      where every other voice scores 82-85%. Malay therefore uses a Mandarin voice.
#
#   ZH + EN  101019  zhitong  Cantonese, premium, female   <- the southern character
#   BM       101003  zhimei   Mandarin,  premium, female   <- reads Malay acceptably
#   plain EN 101051  WeRose   English,   premium, female   <- no Chinese accent
#   alternatives worth hearing: 101016 zhitian (sweetest), 101055 zhiyou, 101002 zhiling
#
# Re-check any of this yourself:
#   python3 tools/compare_tts_voices.py --lab     # builds a listening page
#   python3 tools/roundtrip_voice.py --lang bm --voices 101019 101003
AUNTIEJOY_TTS_VOICE_EN=101019
AUNTIEJOY_TTS_VOICE_ZH=101019
AUNTIEJOY_TTS_VOICE_BM=101003
# Optional single shared voice, used by any language with no voice of its own.
AUNTIEJOY_TTS_VOICE=

# Prosody. EmotionCategory is a REAL control, not a silently ignored field: verified that
# three identical requests are byte-identical, that emotion=neutral differs from sending no
# emotion at all, and that peaceful/sajiao each differ from both. Valid values include:
# neutral, peaceful, sajiao, story, news, happy, sad, angry, fear, radio, poetry, call.
# Leave BLANK to send nothing at all (which is not the same as "neutral").
AUNTIEJOY_TTS_EMOTION=peaceful
# Emotion intensity, [50, 200]. Only meaningful when an emotion is set.
AUNTIEJOY_TTS_EMOTION_INTENSITY=100

# Speaking rate in Tencent's own units, [-2, 6] where 0 = natural pace:
#   -2 = 0.6x   -1 = 0.8x   0 = 1.0x   1 = 1.2x   2 = 1.5x   6 = 2.5x
# One decimal place is allowed for finer steps (e.g. 0.5, 1.1).
# Out-of-range or non-numeric values fall back to 0 instead of breaking speech.
AUNTIEJOY_TTS_SPEED=0
# Volume, [0, 10] where 0 = normal. There is no mute option.
AUNTIEJOY_TTS_VOLUME=0
# 16000 or 8000 only. 16k matches what the ears capture and what the browser decodes.
AUNTIEJOY_TTS_SAMPLE_RATE=16000
# Silence inserted BETWEEN the pieces of a line too long for one request. TextToVoice caps a
# single request, so a long line is synthesised in pieces; concatenating two clips with no gap
# makes the second sentence start on top of the first one's tail, which reads as a stumble
# rather than a pause. Kept short so the line still sounds like ONE utterance -- too long and
# she sounds like she has finished. Range [0, 1000] ms.
AUNTIEJOY_TTS_PIECE_GAP_MS=120

# Which mouth the app speaks with: cartesia (DEFAULT) | texttovoice | texttospeechsse
# The UI's "TRTC Mode" toggle sends the single word "tencent" instead, which the server
# maps to texttospeechsse when streaming is configured and to texttovoice otherwise -- so
# the frontend never has to know which of the two Tencent engines is usable.
AUNTIEJOY_TTS_PROVIDER=cartesia
# 1 = if the selected engine cannot speak, fall back to the other one and report why.
# 0 = fail loudly instead. Either way /health reports the truth.
AUNTIEJOY_TTS_FALLBACK=1


# -----------------------------------------------------------------------------
# 3c. MOUTH, Tencent streaming: TRTC TextToSpeechSSE.
#
#     TextToVoice is synchronous, so a line is synthesised in full before the browser gets
#     its first sample. The TRTC streaming endpoint returns audio incrementally instead, so
#     playback can begin while the rest of the sentence is still being generated.
#
#     This is what "TRTC Mode" prefers when it is configured. It is OPT-IN, and until
#     TRTC_SDK_APP_ID and a TRTC voice id are set, TRTC Mode silently means TextToVoice
#     rather than failing -- /health's tts_trtc_sse_configured says which.
#
#     Reuses the SAME Tencent Cloud SecretId/SecretKey as above. It additionally needs:
#       * TRTC_SDK_APP_ID  - your TRTC application's SDKAppId (integer), distinct from the
#                            TENCENTCLOUD_APPID used by the ears.
#       * one or more TRTC_TTS_VOICE_* ids, which are TRTC tintinnabuli STRINGS such as
#         v-female-R2s4N9qJ, NOT the integer VoiceTypes used by block 3b above.
#     The SDKSecretKey used for UserSig / room entry is a DIFFERENT credential and must never
#     reach the browser; this one belongs to the same account.
#
#     Constraints worth knowing: region is ap-singapore ONLY (pinned, not inherited), one
#     request carries 1-255 characters, the rate limit is 20 requests/second, and the model
#     is fixed at flow_01_turbo. The endpoint is its own setting because the documented
#     examples mandate this exact host and warn the call fails against any other domain.
#
#     There is STILL no Malay voice (the model covers zh / en / yue / ja / ko), so Bahasa
#     Melayu keeps riding the English voice and /health keeps saying so. Cartesia, the
#     default, is the only mouth that reads Malay natively.
# -----------------------------------------------------------------------------
TRTC_SDK_APP_ID=
TRTC_TTS_ENDPOINT=trtc.ai.tencentcloudapi.com
# English voice id, e.g. v-female-R2s4N9qJ
TRTC_TTS_VOICE_EN=
# Chinese voice id
TRTC_TTS_VOICE_ZH=
# Left empty on purpose: no Malay voice exists, so BM borrows the English one.
TRTC_TTS_VOICE_BM=


# -----------------------------------------------------------------------------
# 4. OUTBOUND NETWORK POLICY for the Tencent voice endpoints
#
#    Default (unset / 0): the ASR and TTS calls go DIRECT. They ignore any
#    HTTP_PROXY / HTTPS_PROXY / ALL_PROXY the host shell exports.
#
#    Set to 1 only on a network that genuinely requires an outbound proxy. With
#    the default, a stray proxy (a sandbox or container sidecar, or a forgotten
#    `export http_proxy=...`) cannot silently swallow the call and present itself
#    as a credential or region error. /health reports this as `use_env_proxy`.
# -----------------------------------------------------------------------------
AUNTIEJOY_USE_ENV_PROXY=


# -----------------------------------------------------------------------------
# 5. LOCAL STATE (all optional; defaults shown)
#    Override these in tests so a run never touches the real files.
# -----------------------------------------------------------------------------
# HMAC signing secret for the canonical payment payload.
AUNTIEJOY_SIGNING_SECRET=demo-only-not-a-production-hsm
# Append-only, hash-chained audit log (SQLite).
AUNTIEJOY_DB=auntiejoy_audit.db
# Trusted master data: customers, accounts, saved payees, billers, cards.
AUNTIEJOY_REPO_DB=auntiejoy_repo.db
# Nicknames the customer taught us ("ah girl" -> a beneficiary_id).
AUNTIEJOY_NICKNAMES=nicknames.json


# -----------------------------------------------------------------------------
# 6. PAYMENT RAIL - INERT IN THIS REPO (still parsed, but nothing consults it)
#
#    config.py still reads these so that a .env carried over from the DBS-rail branch
#    loads without error, but this branch has no app/rails.py and no get_rail(): stage 15
#    executes through the deterministic in-memory ledger directly
#    (orchestrator.py, "Ledger.execute(...)"). Setting any value below therefore changes
#    NOTHING -- it is not a switch that can be turned on here.
#
#      AUNTIEJOY_PAYMENT_RAIL / AUNTIEJOY_RAIL_DB
#          the rail selection and its state file
#      DBS_BASE_URL / DBS_CLIENT_ID / DBS_ACCESS_TOKEN / DBS_PARTY_ID
#      DBS_ACCEPT_VERSION / DBS_ALLOWED_CURRENCIES / DBS_TRANSFER_TYPE
#      DBS_PURPOSE_INTERBANK / DBS_RATE_LIMIT_PER_SEC / DBS_MAX_SCHEDULE_DAYS
#          the DBS Fund Transfer API contract, written up in DBS-INTEGRATION-PLAN.md and
#          deliberately NOT implemented in this branch
#
#    They are omitted from the assignments below on purpose: listing a dead knob beside the
#    live ones is how someone comes to believe a demo is running against a real rail.
#    Delete this block and restore the assignments if the rail is ever merged back in.
# -----------------------------------------------------------------------------

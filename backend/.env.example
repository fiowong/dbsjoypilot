# JoyPilot backend settings.
# Copy this file to backend/.env and fill in the keys. Never commit .env.
#
# With every key left empty the app still runs: the agents use their offline mocks and the
# mic and voice stay off. Each section below switches one part on.
# After editing on the server: sudo systemctl restart auntiejoy
# To check what is on: curl -s localhost:8078/health


# --- 1. LLM (the five agents) -------------------------------------------------
# Any OpenAI-compatible endpoint. We use Tencent TokenHub with Hunyuan.
HUNYUAN_API_KEY=
AUNTIEJOY_LLM_BASE=https://tokenhub-intl.tencentcloudmaas.com/v1
# The model id from your TokenHub console. It must belong to the base URL above.
AUNTIEJOY_LLM_MODEL=


# --- 2. Speech to text: Tencent Cloud ASR ------------------------------------
# The same SecretId / SecretKey also power Tencent TTS (TRTC Mode).
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_APPID=


# --- 3. Joy's voice: Cartesia Sonic-3 (the default, and the only Malay voice) -
CARTESIA_API_KEY=
# One voice id per language, from play.cartesia.ai.
CARTESIA_VOICE_ID_EN=
CARTESIA_VOICE_ID_ZH=
CARTESIA_VOICE_ID_BM=


# --- Optional ------------------------------------------------------------------
# Everything below already has a sensible default. Remove the # to change one.
#
# Speaking speed. Cartesia: a multiplier, 0.6 to 1.5. Tencent: -2 to 6, where 0 is normal.
# CARTESIA_SPEED=1.0
# AUNTIEJOY_TTS_SPEED=0
#
# Which voice speaks first: cartesia, or texttovoice (Tencent). The TRTC Mode switch in the
# app changes this live. If one engine fails the other takes over (set 0 to turn that off).
# AUNTIEJOY_TTS_PROVIDER=cartesia
# AUNTIEJOY_TTS_FALLBACK=1
#
# Tencent TTS voice ids (integers). Tencent has no Malay voice.
# AUNTIEJOY_TTS_VOICE_EN=101019
# AUNTIEJOY_TTS_VOICE_ZH=101019
# AUNTIEJOY_TTS_VOICE_BM=101003
#
# Tencent streaming TTS for TRTC Mode. Without these, TRTC Mode uses TextToVoice instead.
# TRTC_SDK_APP_ID=
# TRTC_TTS_VOICE_EN=
# TRTC_TTS_VOICE_ZH=
#
# Region for Tencent ASR and TTS.
# TENCENTCLOUD_REGION=ap-singapore
#
# Demo signing key for the payment payload. Not a real bank HSM.
# AUNTIEJOY_SIGNING_SECRET=demo-only-not-a-production-hsm
#
# The full list of settings and what each one does is in backend/app/config.py.

# secrets
backend/.env
.env

# Python
backend/.venv/
__pycache__/
*.pyc

# local databases / generated data
# -shm / -wal are SQLite's write-ahead-log sidecars; without these they show up as untracked junk
*.db
*.db-shm
*.db-wal

# local dev server logs
frontend/*.log

# OS junk
.DS_Store

# editor folders (optional, remove if you use these deliberately in the repo)
.vscode/
.idea/

.integration-backup/

# editor backups and superseded assets (never deployed)
*.bak
*~*
